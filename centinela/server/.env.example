# =========================================================
#  Centinela · servidor
#  Copia este archivo a .env y llena los valores reales.
#  El .env NUNCA se versiona (ver .gitignore) y debe quedar
#  con permisos 600: chmod 600 .env
# =========================================================

# ---------- Núcleo ----------
PORT=4300
HOST=127.0.0.1
NODE_ENV=development

# ---------- Límites del recolector ----------
# Líneas de contexto que se leen alrededor de cada coincidencia.
# Es a propósito generoso: el reconstructor recorta después por
# semántica, no por número de líneas.
LOG_CONTEXTO_ANTES=40
LOG_CONTEXTO_DESPUES=15

# Ventana de tiempo para considerar que una línea pertenece a la
# misma petición que el request id encontrado.
LOG_VENTANA_MS=5000

# Topes duros. Si se rebasan, el recolector corta y lo reporta.
LOG_MAX_COINCIDENCIAS=200
LOG_MAX_BYTES=5242880
LOG_TIMEOUT_MS=10000

# ---------- Presupuesto y privacidad ----------
TOKEN_PRESUPUESTO=25000
REDACTAR_PII=true

# ---------- Aplicaciones ----------
# Un bloque APP_<N>_* por aplicación, numerados desde 1 sin huecos.
# Genera estos bloques automáticamente con:  npm run descubrir:pm2
#
#   APP_N_ID          identificador corto, es lo que escribes en --app
#   APP_N_NAME        nombre legible
#   APP_N_LOG_OUT     ruta al stdout   (PM2: <app>-out.log)
#   APP_N_LOG_ERR     ruta al stderr   (PM2: <app>-error.log)
#   APP_N_LOG_APP     log propio de la app (ej. server/logs/app.log)
#   APP_N_LOG_FORMAT  corchetes | json | auto
#   APP_N_DB_URL      connection string DE SOLO LECTURA
#
# Las tres rutas de log aceptan varias separadas por coma y comodín
# en el nombre del archivo, p. ej.:  /ruta/app-out__*.log

APP_1_ID=comunidad
APP_1_NAME=Comunidad
APP_1_LOG_OUT=./logs-demo/comunidad-out.log
APP_1_LOG_ERR=
APP_1_LOG_APP=
APP_1_LOG_FORMAT=corchetes
APP_1_DB_URL=

# Ejemplo de una app real en producción bajo PM2 + Mongo Atlas.
# Ojo: el usuario de Mongo debe tener SOLO el rol "read".
#
# APP_2_ID=avmendoza
# APP_2_NAME=AV Mendoza
# APP_2_LOG_OUT=/home/deploy/.pm2/logs/avmendoza-out.log
# APP_2_LOG_ERR=/home/deploy/.pm2/logs/avmendoza-error.log
# APP_2_LOG_APP=/home/deploy/apps/avmendoza/server/logs/avmendoza.log
# APP_2_LOG_FORMAT=corchetes
# APP_2_DB_URL=mongodb+srv://USUARIO_RO:CONTRASENA@HOST/BASE?retryWrites=true&w=majority
